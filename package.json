{
  "name": "pomomo",
  "version": "1.0.0",
  "description": "Pomodoro planner with draggable task and break blocks",
  "productName": "Pomomo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.pomomo.app",
    "productName": "Pomomo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pomomo"
    },
    "portable": {
      "artifactName": "Pomomo-Portable-${version}.${ext}"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!*.log",
      "!.git/**/*"
    ]
  },
  "private": true,
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  }
}
